# ── AI model keys ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROK_API_KEY=
MISTRAL_API_KEY=

# ── Payments & email (required for subscription features) ─────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
FROM_EMAIL=support@creativekonsoles.com

# ── Infrastructure ─────────────────────────────────────────────────────────────
KALSHI_API_KEY=
DEEPSEEK_API_KEY=
SENTRY_DSN=
