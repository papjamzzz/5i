# ── Owner/admin ────────────────────────────────────────────────────────────────
# Required to use /admin/issue-token and /kalshi-fusion/order (real-money trades).
# Both endpoints fail closed (403) if this is unset — set a long random value.
ADMIN_KEY=
# Optional: unlimited personal-use token for verify_token(), bypasses subscription
# checks on /ask and /kalshi-fusion/analyze. Leave unset to disable the bypass.
OWNER_TOKEN=
